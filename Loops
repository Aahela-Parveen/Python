        print(n,end=" ")


17. FIND GCD / HCF:
a = int(input("Enter first number: "))
b = int(input("Enter second number: "))
gcd = 1
for i in range(1,min(a,b)+1):
    if a % i == 0 and b % i == 0:
        gcd = i
print("GCD =",gcd)


18. FIND LCM:
a = int(input("Enter first number: "))
b = int(input("Enter second number: "))
lcm = max(a,b)
while lcm % a != 0 or lcm % b != 0:
    lcm = lcm + 1
print("LCM =",lcm)


