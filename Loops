13. CHECK PALINDROME NUMBER:
n = int(input("Enter a number: "))
original = n
rev = 0
while n != 0:
    digit = n % 10
    rev = rev * 10 + digit
    n = n // 10
if original == rev:
    print("Palindrome")
else:
    print("Not Palindrome")


14. CHECK ARMSTRONG NUMBER:
n = int(input("Enter a number: "))
original = n
sum = 0
while n != 0:
    digit = n % 10
    sum = sum + digit ** 3
    n = n // 10
if original == sum:
    print("Armstrong Number")
else:
    print("Not Armstrong Number")


