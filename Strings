1. FIND STRING LENGTH:
text = input("Enter a string: ")
print("Length =",len(text))


2. COPY A STRING:
text = input("Enter a string: ")
copy = text
print("Copied String =",copy)


3. CONCATENATE TWO STRINGS:
a = input("Enter first string: ")
b = input("Enter second string: ")
print("Concatenated String =",a+b)


4. COMPARE TWO STRINGS:
a = input("Enter first string: ")
b = input("Enter second string: ")
if a == b:
    print("Strings are Equal")
else:
    print("Strings are Not Equal")


5. REVERSE A STRING:
text = input("Enter a string: ")
print("Reverse =",text[::-1])


6. CHECK STRING PALINDROME:
text = input("Enter a string: ")
if text == text[::-1]:
    print("Palindrome")
else:
    print("Not Palindrome")


7. COUNT VOWELS AND CONSONANTS:
text = input("Enter a string: ")
vowels = 0
consonants = 0
for ch in text:
    if ch in "aeiouAEIOU":
        vowels = vowels + 1
    elif ch.isalpha():
        consonants = consonants + 1
print("Vowels =",vowels)
print("Consonants =",consonants)


8. COUNT WORDS IN A STRING:
text = input("Enter a string: ")
words = text.split()
print("Words =",len(words))


9. COUNT DIGITS AND SPECIAL CHARACTERS:
text = input("Enter a string: ")
digits = 0
special = 0
for ch in text:
    if ch.isdigit():
        digits = digits + 1
    elif not ch.isalnum() and ch != " ":
        special = special + 1
print("Digits =",digits)
print("Special Characters =",special)


10. CONVERT LOWERCASE TO UPPERCASE:
text = input("Enter a string: ")
print("Uppercase =",text.upper())


11. CONVERT UPPERCASE TO LOWERCASE:
text = input("Enter a string: ")
print("Lowercase =",text.lower())


12. FIND FREQUENCY OF CHARACTERS:
text = input("Enter a string: ")
for ch in set(text):
    print(ch,"=",text.count(ch))


13. REMOVE SPACES FROM STRING:
text = input("Enter a string: ")
text = text.replace(" ","")
print("String =",text)

